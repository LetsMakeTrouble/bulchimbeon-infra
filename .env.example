# 불침번 전체 스택 환경변수 템플릿 (`docker-compose.yml`).
#
#   cp .env.example .env      # 값을 채운 뒤
#   docker compose up -d --build
#
# ⛔ `.env` 는 커밋하지 마라 — `.gitignore` 의 `.env` · `.env.*` 가 막고 있다.
# ⛔ 아래 값 중 하나라도 비면 compose 가 **기동 전에** 죽는다. 그게 의도다:
#    `SECRET_KEY=change-me` 인 채로 조용히 뜨는 것보다 안 뜨는 쪽이 낫다.

# --- DB -------------------------------------------------------------------------------
POSTGRES_USER=bulchimbeon
POSTGRES_DB=bulchimbeon
# 생성: openssl rand -hex 24
#
# ⛔ **이 값은 `pgdata` 볼륨이 처음 만들어질 때만 적용된다.** 볼륨이 이미 있으면 Postgres 가
#    "Skipping initialization" 하고 넘어가므로, 여기를 바꿔도 **DB 안의 비밀번호는 그대로**다.
#    그러면 이렇게 죽는다:
#
#      db-1      | FATAL: password authentication failed for user "bulchimbeon"
#      migrate-1 | asyncpg.exceptions.InvalidPasswordError
#
#    `.env` 를 지웠다 다시 만들면 여기에 걸린다. 데이터가 아깝지 않으면 볼륨을 버려라:
#      docker compose down -v      # ⚠️ pgdata·storage 를 모두 지운다
#    운영 데이터가 있으면 볼륨을 지우지 말고 **이 줄을 예전 값으로 되돌려라.**
#
# ⚠️ **base64 를 쓰지 마라.** 이 값은 compose 가 URL 로 조립한다
#    (`postgresql+asyncpg://user:PASSWORD@db:5432/db`). base64 알파벳의 `/` 가 나오면
#    URL 의 authority 가 거기서 끊겨 기동과 마이그레이션이 함께 실패한다.
#    hex 는 [0-9a-f] 뿐이라 안전하고 24바이트=192비트로 강도는 같다.
POSTGRES_PASSWORD=

# --- 비밀값 ---------------------------------------------------------------------------
# 로그인 토큰 서명 키. 이 값이 알려지면 **누구나 아무 계정으로 로그인할 수 있다.**
# 생성: openssl rand -hex 32
SECRET_KEY=

# 연동(Notion·GitHub) 토큰을 DB 에 암호화해 넣는 키. 32바이트 이상.
# 이 값을 잃으면 등록된 연동 토큰을 복호화하지 못해 **전부 재등록**해야 한다.
# 생성: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=

# 생성: platform.openai.com. ⚠️ 계정 쪽에서 지출 한도를 함께 걸어라.
OPENAI_API_KEY=

# 시드 데모 계정 비밀번호. **심사·시연용으로 공개 고정값을 쓴다** — 심사위원이 이 값을
# 그대로 받아 로그인한다. 바꾸면 안내 문서와 어긋나므로 그대로 둔다.
# ⚠️ 담당자 계정(mike@devcorp.example)은 임계값 변경·문서 삭제 권한을 가진다.
#    시연이 끝나면 인스턴스를 내리거나 값을 바꾸고 재시드해라.
# 데모 계정을 아예 안 만들 거면 시드를 돌리지 않으면 된다.
DEMO_PASSWORD=demo1234!

# --- 라우팅 ---------------------------------------------------------------------------
# 앞단(Cloudflare Tunnel)이 한 도메인을 받아 `/api/*` 는 `api:8000` 으로, 나머지는
# `web:8080` 으로 보낸다. 브라우저 입장에서 프론트와 API 가 **같은 오리진**이다.
# 그래서 프론트 nginx 에 `/api` 프록시 블록이 없다 — 홉을 늘리지 않는다.

# 상대 경로다. 같은 오리진이라 CORS 를 타지 않는다.
# ⚠️ **빌드 시각에 번들로 박히는 값이다.** 고쳤으면 `docker compose up -d --build` 로
#    프론트를 다시 말아야 한다 — 런타임 재시작은 소용없다.
# ⚠️ 끝의 `/api/v1` 을 빼먹지 마라. 백엔드 라우터가 전부 그 아래에 있다.
VITE_API_BASE_URL=/api/v1

# 터널이 받는 공개 도메인. 아래 두 값 모두 같은 주소다.
# ⚠️ 스킴까지 정확히 적는다. 쉼표 구분. 와일드카드(`*`) 금지 —
#    백엔드가 `allow_credentials=True` 라 와일드카드와 함께면 위험하다.
#    같은 오리진이면 CORS 프리플라이트가 안 뜨지만, 오타는 로컬 개발 오리진을
#    추가하는 순간 "모든 요청 차단" 으로만 드러난다.
CORS_ORIGINS=https://bulchimbeon.quanect.kr

# 알림·연동 링크에 박히는 공개 주소.
API_BASE_URL=https://bulchimbeon.quanect.kr

# --- 선택 -----------------------------------------------------------------------------
APP_ENV=demo

# 터널이 붙을 포트.
# ⚠️ compose 가 이 포트를 **모든 인터페이스에** 연다. cloudflared 가 다른 LXC 에서
#    LAN 을 건너오기 때문이며, 이 서버에 공인 IP 가 없어서 터널을 쓰는 것이므로
#    열려도 LAN 까지다. 루프백으로 묶으면 터널이 못 붙어 502 가 난다.
#    터널을 같은 compose 망의 컨테이너로 옮긴다면 포트를 지우고 `api:8000` ·
#    `web:8080` 서비스 이름으로 붙으면 된다.
API_PORT=8000
WEB_PORT=8080

# 동시성 — 세 값은 함께 움직인다.
# ⚠️ DB 의 max_connections 가 빠듯하면(소형 인스턴스는 20~25) 셋을 같이 줄여라.
#    파이프라인 1건이 커넥션 1개를 5~15초 붙잡는다.
PIPELINE_MAX_CONCURRENCY=8
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
