# ⛔ 셸 스크립트는 항상 LF 다. 개발자는 Windows 고 배포 대상은 Linux 인데,
#    CRLF 로 체크아웃된 채 컨테이너나 서버로 들어가면 shebang 이
#    `/usr/bin/env sh\r` 로 읽혀 `bad interpreter` 로 죽는다.
#    증상이 "파일은 분명히 있는데 없다고 한다" 라 진단이 오래 걸린다.
*.sh text eol=lf

# compose 와 env 템플릿도 같은 이유로 LF 로 고정한다. compose 는 CRLF 를 견디지만,
# `.env` 는 값 끝에 `\r` 이 붙어 그대로 컨테이너 환경변수가 된다 —
# `CORS_ORIGINS=https://…\r` 은 오리진 비교에서 조용히 어긋나 전 요청이 차단된다.
*.yml text eol=lf
.env.example text eol=lf
